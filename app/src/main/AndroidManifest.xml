<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only apps signed with the same key may bind the LLM host service -->
    <permission
        android:name="com.arkj.llmserver.permission.BIND_LLM_SERVICE"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="ArkLlm Host"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.LlmHost"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LlmHostService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="com.arkj.llmserver.permission.BIND_LLM_SERVICE">
            <intent-filter>
                <action android:name="com.arkj.llm.contract.ILlmService" />
            </intent-filter>
        </service>
    </application>
</manifest>
